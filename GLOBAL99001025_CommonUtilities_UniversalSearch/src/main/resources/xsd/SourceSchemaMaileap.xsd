<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" xmlns:d="http://schemas.microsoft.com/ado/2007/08/dataservices">
  <xs:element name="feed">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="xs:anyURI"/>
        <xs:element name="title" type="xs:string"/>
        <xs:element name="updated" type="xs:dateTime"/>
        <xs:element name="author">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="name" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="link" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="href" type="xs:anyURI" use="required"/>
            <xs:attribute name="rel" type="xs:string" use="required"/>
            <xs:attribute name="title" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="entry" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="id" type="xs:anyURI"/>
              <xs:element name="title" type="xs:string"/>
              <xs:element name="updated" type="xs:dateTime"/>
              <xs:element name="category">
                <xs:complexType>
                  <xs:attribute name="term" type="xs:string" use="required"/>
                  <xs:attribute name="scheme" type="xs:anyURI" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="link" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="href" type="xs:anyURI" use="required"/>
                  <xs:attribute name="rel" type="xs:string" use="required"/>
                  <xs:attribute name="title" type="xs:string" use="required"/>
                  <xs:attribute name="type" type="xs:string" use="optional"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="content">
                <xs:complexType>
                  <xs:attribute name="type" type="xs:string" use="required"/>
                  <xs:attribute name="src" type="xs:anyURI" use="optional"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="properties" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Id" type="xs:string"/>
                    <xs:element name="Name" type="xs:string"/>
                    <xs:element name="ResourceId" type="xs:string"/>
                    <xs:element name="Description" type="xs:string"/>
                    <xs:element name="ShortText" type="xs:string"/>
                    <xs:element name="Version" type="xs:string" minOccurs="0"/>
                    <xs:element name="Vendor" type="xs:string" minOccurs="0"/>
                    <xs:element name="PartnerContent" type="xs:boolean"/>
                    <xs:element name="UpdateAvailable" type="xs:boolean"/>
                    <xs:element name="Mode" type="xs:string"/>
                    <xs:element name="SupportedPlatform" type="xs:string"/>
                    <xs:element name="ModifiedBy" type="xs:string"/>
                    <xs:element name="CreationDate" type="xs:long"/>
                    <xs:element name="ModifiedDate" type="xs:long"/>
                    <xs:element name="CreatedBy" type="xs:string"/>
                    <xs:element name="Products" type="xs:string" minOccurs="0"/>
                    <xs:element name="Keywords" type="xs:string" minOccurs="0"/>
                    <xs:element name="Countries" type="xs:string" minOccurs="0"/>
                    <xs:element name="Industries" type="xs:string" minOccurs="0"/>
                    <xs:element name="LineOfBusiness" type="xs:string" minOccurs="0"/>
                    <xs:element name="PackageContent" minOccurs="0">
                      <xs:complexType>
                        <xs:attribute name="null" type="xs:boolean" use="optional"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="base" type="xs:anyURI" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
