<?xml version="1.0" encoding="UTF-8" standalone="no"?><parameters>
  <parameter>
    <key/>
    <name>Vendor Portal HTTPS Path (e.g. /vendor-onboarding/register)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Inbound HTTPS URL path for vendor registration webhook</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Procurement OData V4 URL (e.g. https://procurement.example.com/api/v4)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Procurement system OData V4 base URL for vendor master creation</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Procurement Credential (e.g. Procurement_BasicCreds)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Security Material alias for procurement system authentication</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>SAP IDoc Receiver Address (e.g. https://erp.example.com/sap/idoc)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>SAP ERP IDoc receiver endpoint for CREMAS05 vendor master</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>SAP IDoc Credential (e.g. SAP_ERP_Creds)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Security Material alias for SAP ERP IDoc authentication</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Risk Score Threshold (e.g. 70)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Numeric risk score threshold; scores above this are flagged HIGH</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Nightly Reconciliation Schedule</name>
    <type>custom:schedule</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Cron schedule for nightly vendor reconciliation job (default 1 AM)</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Procurement OData V2 URL (e.g. https://procurement.example.com/odata/v2)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Procurement system OData V2 base URL for active vendor fetch</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Finance SFTP Host (e.g. sftp.finance.example.com)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Finance team SFTP server hostname</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Finance SFTP Path Outbound (e.g. /outbound/reports)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>SFTP path for dropping reconciliation report files</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Finance SFTP Path Inbound ACK (e.g. /inbound/ack)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>SFTP path to poll for acknowledgement files from finance</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Finance SFTP Path Bank Details (e.g. /inbound/bank-updates)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>SFTP path monitored for incoming bank detail update files</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Finance SFTP Credential (e.g. Finance_SFTP_Creds)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Security Material alias for finance SFTP authentication</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Bank Validation API URL (e.g. https://bankvalidate.example.com/api/v1/validate)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>External bank validation REST API endpoint</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Bank Validation API Credential (e.g. BankValidate_OAuth2)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Security Material alias for bank validation API OAuth2 client credentials</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Legacy SOAP Partner Address (e.g. https://legacy.partner.example.com/po/confirm)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Downstream legacy SOAP partner endpoint for PO confirmation</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Legacy SOAP Credential (e.g. LegacyPartner_Creds)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Security Material alias for legacy SOAP partner authentication</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>PO Invoice iFlow Address (e.g. /po-invoice-matching)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>ProcessDirect address of the existing PO-to-Invoice-Matching iFlow</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>SuccessFactors URL (e.g. https://api.successfactors.com)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>SuccessFactors API base URL for contractor/employee enrichment lookups</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>SuccessFactors Credential (e.g. SF_OAuth_Creds)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Security Material alias for SuccessFactors authentication</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>ServiceNow URL (e.g. https://yourinstance.service-now.com)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>ServiceNow instance base URL for ticket creation and compliance checks</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>ServiceNow Credential (e.g. ServiceNow_BasicCreds)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Security Material alias for ServiceNow authentication</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Mail Server (e.g. smtp.example.com)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>SMTP server hostname for all outbound email notifications</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Mail From (e.g. cpi-alerts@example.com)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Sender email address for all CPI-generated notifications</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Mail Credential (e.g. SMTP_Credentials)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Security Material alias for SMTP authentication</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Compliance Officer Email (e.g. compliance@example.com)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Email address for compliance officer - receives high-risk alerts and error notifications</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Procurement Email (e.g. procurement@example.com)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Email address for procurement team notifications</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Logging Service URL (e.g. https://logging.example.com/api/ingest)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Audit logging service endpoint - receives JSON-formatted audit records</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Logging Service Credential (e.g. LoggingService_Creds)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Security Material alias for logging service authentication</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>Audit Log Retention Days (e.g. 90)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>Number of days to retain audit entries in the data store before purging</description>
    <additionalMetadata/>
  </parameter>
  <parameter>
    <key/>
    <name>JMS Queue Name (e.g. Vendor_Master_Sync)</name>
    <type>xsd:string</type>
    <isRequired>false</isRequired>
    <constraint/>
    <description>JMS queue name for downstream Vendor Master Sync process messages</description>
    <additionalMetadata/>
  </parameter>
</parameters>